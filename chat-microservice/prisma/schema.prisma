generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql" // or "mysql", "sqlite", etc.
    url      = env("DATABASE_URL")
}

model Chat {
    chatId    String    @id @unique @default(uuid())
    user1Id   String
    user2Id   String
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    messages Message[]

    @@unique([user1Id, user2Id])
    @@index([user1Id, user2Id])
}

model Message {
    messageId  String    @id @unique @default(uuid())
    chatId     String
    senderId   String
    receiverId String
    content    String
    sentAt     DateTime  @default(now())
    deletedAt  DateTime?

    chat Chat @relation(fields: [chatId], references: [chatId], onDelete: Cascade)

    @@index([chatId])
    @@index([senderId])
    @@index([receiverId])
}
