// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Notification {
    notificationId String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    type           String // Type of notification (e.g., "LIKE", "COMMENT", "FOLLOW", "MENTION")
    message        String // Notification message text
    isRead         Boolean  @default(false) // Whether the notification has been read
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    // Relationships
    userId  String // The user who receives the notification
    actorId String? // The user who performed the action (e.g., liked a post)

    postId String? // Optional: If the notification relates to a specific post
}
